# Marked — environment variables
# Copy to .env.local for local development. Never commit real values.
#
# See VERCEL_ENVIRONMENT.md for the full audit of what is actually consumed
# by the deployed app (source-verified, not assumed) versus what is declared
# here but currently inert. Default (MARKED_STORAGE_DRIVER unset/"sqlite")
# does NOT survive Vercel's serverless filesystem for ARM/APPROVE/DISARM —
# set MARKED_STORAGE_DRIVER=postgres + a real DATABASE_URL for durable
# production persistence. Read VERCEL_ENVIRONMENT.md before deploying.

# --- App ---
# Declared and defaulted in packages/config/src/env.ts, but not currently
# read or rendered anywhere in the app. Safe to leave unset.
NEXT_PUBLIC_APP_ENV=development

# --- Storage driver (Gate 11) ---
# "sqlite" (default, if unset) — local file at apps/web/.data/marked.sqlite,
# for local dev/tests. Does not survive Vercel's serverless filesystem.
# "postgres" — durable production persistence via PostgresFulfillmentJobStore
# (packages/db/src/postgres-fulfillment-job-store.ts). Requires DATABASE_URL
# below to also be set, and the schema to already be migrated
# (pnpm db:migrate) — see VERCEL_ENVIRONMENT.md for the exact setup order.
# Any other value, or "postgres" with no DATABASE_URL, fails closed with a
# typed PersistenceConfigurationError rather than silently using SQLite.
MARKED_STORAGE_DRIVER=sqlite

# --- Database — consumed ONLY when MARKED_STORAGE_DRIVER=postgres ---
# Read directly by apps/web/src/lib/job-store.ts. A local/example value like
# the one below will NOT work against a real Postgres server — replace
# USER/PASSWORD/HOST/DATABASE with a real connection string, or leave
# MARKED_STORAGE_DRIVER unset to skip this entirely. Never commit a real
# value here. Server-only — never NEXT_PUBLIC_*, never logged.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Cactus (packages/cactus) — server-only, never NEXT_PUBLIC_* ---
# Optional. Enables Cactus's official authenticated GraphQL API as the
# first-choice resolution path. Without it, Marked resolves the real, live
# public Cactus proposal page instead (the current default) — this is a
# live network call to real Cactus infrastructure, not a mock or fallback
# to fixture data.
CACTUS_API_KEY=

# --- KeeperHub (packages/keeperhub) — NOT REQUIRED on Vercel ---
# Consumed only by local, developer-run scripts (scripts/gate5-keeperhub-
# execute.ts, scripts/prove-keeperhub-seam.ts). The deployed Next.js app
# never calls KeeperHub live — there is no served route that does. Needed
# only if you are re-running those scripts yourself.
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=

# --- Chain RPC — optional ---
# Overrides the public default RPC endpoint viem falls back to when unset.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=

# --- Gate 5 test-fixture deployer (scripts/ ONLY — never used by Marked's own
# fulfillment path, which has no local broadcaster). Funded with Sepolia test
# ETH only. Used once to deploy a controlled Governor Bravo + Timelock +
# voting-token stack for the live KeeperHub lifecycle proof. Never commit a
# real value. See evidence/lifecycle-fulfillment/controlled-governor.md. ---
GATE5_DEPLOYER_PRIVATE_KEY=

# --- LLM / Marked Agent — see apps/web/.env.example for the full set
# (MARKED_AGENT_PROVIDER, OPENROUTER_API_KEY, OPENROUTER_MODEL,
# ANTHROPIC_API_KEY, MARKED_AGENT_MODEL). LLM_API_KEY below is a legacy
# alternate name accepted for the Anthropic path — narration/plan
# preparation only, never authoritative over execution. ---
LLM_API_KEY=

# --- Safety flags — NOT REQUIRED on Vercel today ---
# Declared and unit-tested in packages/config, but not currently read from
# process.env anywhere. The real mainnet-write guard in the one place it
# matters (scripts/gate5-keeperhub-execute.ts) is a hardcoded `false`
# literal, not an env read. Setting these has no effect on current
# behavior — see VERCEL_ENVIRONMENT.md.
ENABLE_MAINNET_WRITE=false
ENABLE_PUBLIC_RECEIPTS=true
