# Marked — environment variables
# Copy to .env.local for local development. Never commit real values.
# Parsed and validated by packages/config/src/env.ts (Zod). A missing or
# malformed value must never silently enable a mainnet write.

# --- App ---
NEXT_PUBLIC_APP_ENV=development

# --- Database (packages/db, Drizzle + Postgres) ---
DATABASE_URL=postgresql://user:password@localhost:5432/marked_dev

# --- Cactus (packages/cactus) — server-only, never NEXT_PUBLIC_* ---
CACTUS_API_KEY=

# --- KeeperHub (packages/keeperhub) — server-only ---
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=

# --- Chain RPC ---
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=

# --- Gate 5 test-fixture deployer (scripts/ ONLY — never used by Marked's own
# fulfillment path, which has no local broadcaster). Funded with Sepolia test
# ETH only. Used once to deploy a controlled Governor Bravo + Timelock +
# voting-token stack for the live KeeperHub lifecycle proof. Never commit a
# real value. See evidence/lifecycle-fulfillment/controlled-governor.md. ---
GATE5_DEPLOYER_PRIVATE_KEY=

# --- LLM (narration / workflow draft only — never authoritative) ---
LLM_API_KEY=

# --- Safety flags ---
# Hard default is false. Must be an explicit "true" string to enable.
ENABLE_MAINNET_WRITE=false
ENABLE_PUBLIC_RECEIPTS=true
