# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/

# vercel
.vercel/

# build output
dist/
build/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
!.env.example

# testing
coverage/
playwright-report/
test-results/
blob-report/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# claude code — personal, machine-local overrides and runtime state (never
# commit). Gate 12 §61/§23 found .claude/scheduled_tasks.lock (a session
# pid/timestamp lock file) and root .mcp.json (a local MCP tool config,
# currently only a bare KeeperHub URL but the kind of file that commonly
# grows a credential field) both untracked with no ignore rule protecting
# them — named explicitly here rather than blanket-ignoring .claude/, in
# case this project later wants to track shared .claude/ content (commands,
# agents) the way some repos do.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.mcp.json

# os
.DS_Store
Thumbs.db

# local databases — the trailing * also catches WAL/SHM sidecar files
# (marked.sqlite-wal, marked.sqlite-shm) that a bare *.sqlite would miss
*.sqlite*
*.sqlite3*
*.db
apps/web/.data/

# secrets — never commit these
*.pem
*.key
wallet*.json
mnemonic*
*private-key*
*.env.production

# foundry
contracts/cache/
contracts/out/
contracts/broadcast/
