[
  {
    "id": "44lgxni4vkr1s7fle8r6w",
    "name": "Aave Health Factor Monitor",
    "description": "Check your Aave v3 health factor hourly, and when it drops below the 1.5 safety threshold alert both Discord and email.",
    "userId": "NUNTVo3ZpnXAXnvz30lciE54Wg4UiW7O",
    "organizationId": "28fbcb43-3eee-483b-97b6-2d1227ccbecd",
    "isAnonymous": false,
    "featured": false,
    "featuredOrder": 0,
    "featuredProtocol": null,
    "featuredProtocolOrder": 0,
    "projectId": null,
    "tagId": null,
    "nodes": [
      {
        "id": "trigger-1",
        "data": {
          "type": "trigger",
          "label": "Trigger",
          "config": {
            "triggerType": "Schedule",
            "scheduleCron": "0 * * * *",
            "scheduleTimezone": "UTC"
          },
          "status": "idle"
        },
        "type": "trigger",
        "position": {
          "x": 0,
          "y": 116
        }
      },
      {
        "id": "step-1",
        "data": {
          "type": "action",
          "label": "Get Aave Health Factor",
          "config": {
            "user": "",
            "network": "1",
            "actionType": "aave-v3/get-user-account-data",
            "_protocolMeta": "{\"protocolSlug\":\"aave-v3\",\"contractKey\":\"pool\",\"functionName\":\"getUserAccountData\",\"actionType\":\"read\"}"
          },
          "status": "idle",
          "description": "Read the health factor from Aave v3 for the monitored wallet"
        },
        "type": "action",
        "position": {
          "x": 252,
          "y": 116
        }
      },
      {
        "id": "step-2",
        "data": {
          "type": "action",
          "label": "Condition",
          "config": {
            "group": {
              "id": "group-1",
              "logic": "AND",
              "rules": [
                {
                  "id": "rule-1",
                  "operator": "<",
                  "leftOperand": "{{@step-1:Get Aave Health Factor.healthFactor}}",
                  "rightOperand": "1500000000000000000"
                }
              ]
            },
            "condition": "{{@step-1:Get Aave Health Factor.healthFactor}} < 1500000000000000000",
            "actionType": "Condition"
          },
          "status": "idle"
        },
        "type": "action",
        "position": {
          "x": 504,
          "y": 116
        }
      },
      {
        "id": "step-3",
        "data": {
          "type": "action",
          "label": "Send Discord Alert",
          "config": {
            "actionType": "discord/send-message",
            "integrationId": "",
            "discordMessage": "Aave v3 health factor dropped to {{step-1.healthFactor}}, below the 1.5 safety threshold. Consider adding collateral or repaying debt."
          },
          "status": "idle",
          "description": "Send a notification to a Discord channel"
        },
        "type": "action",
        "position": {
          "x": 756,
          "y": 0
        }
      },
      {
        "id": "step-4",
        "data": {
          "type": "action",
          "label": "Send Email Alert",
          "config": {
            "emailTo": "",
            "emailBody": "Your Aave v3 health factor is {{step-1.healthFactor}}, below the 1.5 safety threshold. Consider adding collateral or repaying debt to avoid liquidation.",
            "actionType": "sendgrid/send-email",
            "emailSubject": "Aave health factor alert",
            "useKeeperHubApiKey": true
          },
          "status": "idle",
          "description": "Send an email notification"
        },
        "type": "action",
        "position": {
          "x": 756,
          "y": 232
        }
      }
    ],
